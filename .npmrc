# EAS Build images ship pnpm 11, which enforces a 24h minimumReleaseAge
# supply-chain policy and runs `pnpm install --frozen-lockfile`. Matching the
# policy here means a lockfile that resolves locally also installs on EAS.
minimum-release-age=1440

# NativeWind's babel preset emits `import ... from "react-native-css-interop/jsx-runtime"`
# into every compiled file (importSource is hardcoded in nativewind/babel), so the
# package must resolve from the project root. It is a transitive dep of nativewind,
# which pnpm does not hoist by default -- Metro then fails with
# "Unable to resolve module react-native-css-interop/jsx-runtime".
# The first two patterns are pnpm's defaults, restated because setting this key replaces them.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*react-native-css-interop*
